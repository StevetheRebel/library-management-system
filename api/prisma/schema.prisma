generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  role  Role   @default(PATRON)
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]
}

model Book {
  id      Int    @id @default(autoincrement())
  title   String
  author  String
  genreId Int
  genre   Genre  @relation(fields: [genreId], references: [id])

  @@unique([title, author])
}